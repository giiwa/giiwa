import os, sys, platform, time, subprocess, threading, configparser
import psutil, atexit, gc
from datetime import datetime
from zoneinfo import ZoneInfo

try:
    import requests
except:
    print(f"{e}")


global logfile,conf,startup

logfile = "/var/log/appdog.log"
startup = int(time.strftime("%H", time.localtime()))

def _log(x):
    global logfile
    try:
        x1 = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime()) + ' ' + x
        with open(logfile, "a+", encoding="utf-8") as f1:
            print(x1, file=f1)
    except Exception as e:
        pass

def _safe_popen(cmd):
    fp = os.popen(cmd)
    try:
        return fp.readlines()
    finally:
        fp.close()

def _load_config():
    global conf, logfile
    conf = configparser.ConfigParser()
    try:
        if os.path.isfile("/etc/appdog.conf"):
            conf.read("/etc/appdog.conf")
        else:
            conf.read("appdog.conf")
        logfile = conf.get("global", "log")
    except Exception as e:
        _log(f'read error: appdog.conf, {str(e)}')
        sys.exit(1)

def _startapp(cmd, user):
    _log(f"starting app: {cmd}, user: {user}")
    try:
        if user and user.strip():
            run_cmd = ["su", "-s", "/bin/bash", user, "-c", cmd]
            subprocess.Popen(run_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        _log(f"start success: {cmd}")
    except Exception as e:
        _log(f"start failed: {e}")

def _pidx(pattern):
    try:
        lines = _safe_popen(f"ps aux | grep '{pattern}' | grep -v 'grep'")
        if not lines:
            return -1, -1
        parts = lines[0].split()
        pid = int(parts[1])
        cpu = float(parts[2])
        return pid, cpu
    except Exception:
        return -1, -1

def _app_main(x):
    global conf, startup

    command = conf.get(x, "start", fallback="")
    pattern = conf.get(x, "pattern", fallback="")
    health = conf.get(x, "health", fallback="")
    error = conf.get(x, "error", fallback="")
    user = conf.get(x, "user", fallback="")
    check = conf.getfloat(x, "check", fallback=3.0)
    max_cpu = conf.getfloat(x, "max_cpu", fallback=-1.0)
    enabled = conf.getint(x, "enabled", fallback=1)
    recycle = conf.getint(x, 'recycle', fallback=-1)

    if enabled <= 0:
        _log(f"{x} disabled, skip.")
        return

    _log(f'monitoring {x} ...')
    pid = -1
    while True:
        try:
            if pid == -1:
                pid, cpu = _pidx(pattern)
                # CPU 超限杀进程
                if max_cpu > 0 and cpu >= max_cpu:
                    _log(f"[{x}] killed for high cpu={cpu}")
                    _safe_popen(f"kill {pid}")
                    time.sleep(2)
                    _safe_popen(f"kill -9 {pid}")
                    pid = -1

            if pid != -1:
                try:
                    p = psutil.Process(pid)
                    if p.is_running():
                        # 定时回收重启
                        now_hour = int(time.strftime("%H", time.localtime()))
                        if recycle > -1 and startup != now_hour:
                            _log(f"[{pid}] killed by recycle rule")
                            _safe_popen(f"kill {pid}")
                            time.sleep(2)
                            _safe_popen(f"kill -9 {pid}")
                            pid = -1
                        else:
                            # 健康检查
                            if health.startswith("http://"):
                                r = None
                                try:
                                    r = requests.get(health, timeout=check)
                                    if r.status_code != 200:
                                        raise Exception("health check fail")
                                finally:
                                    if r:
                                        r.close()
                            # 错误日志检查
                            if error.startswith("tail"):
                                err_lines = _safe_popen(error)
                                if err_lines:
                                    raise Exception("error log detected")
                    else:
                        raise Exception("process not running")
                except Exception as e:
                    if pid > 0:
                        _log(f"[{x}] killed by exception: {e}")
                        _safe_popen(f"kill {pid}")
                        time.sleep(2)
                        _safe_popen(f"kill -9 {pid}")
                    pid = -1

            # 进程不存在则启动
            if pid == -1:
                _startapp(command, user)

        except Exception as e:
            _log(f"_app_main error: {str(e)}")

        gc.collect()
        time.sleep(check)

def _cron_main(x):
    global conf
    command = conf.get(x, "start", fallback="")
    user = conf.get(x, "user", fallback="")
    enabled = conf.getint(x, "enabled", fallback=1)
    time_str = conf.get(x, 'time', fallback="0 0 0 0 0")
    timepoint = time_str.split()

    if enabled <= 0:
        _log(f"{x} disabled, skip.")
        return

    while True:
        try:
            check = 40
            t1 = time.localtime()
            tm_min, tm_hour, tm_wday, tm_mday, tm_mon = timepoint

            match = True
            if tm_min != '*' and int(tm_min) != t1.tm_min:
                match = False
            if tm_hour != '*' and int(tm_hour) != t1.tm_hour:
                match = False
            if tm_wday != '*' and int(tm_wday) != (t1.tm_wday + 1):
                match = False
            if tm_mday != '*' and int(tm_mday) != t1.tm_mday:
                match = False
            if tm_mon != '*' and int(tm_mon) != t1.tm_mon:
                match = False

            if match:
                _log(f'run cron {x}')
                _startapp(command, user)
                check = 100
        except Exception as e:
            _log(f"_cron_main error: {e}")

        gc.collect()
        time.sleep(check)

def _docker_main(x):
    global conf

    health = conf.get(x, "health", fallback="")
    check = int(conf.getfloat(x, "check", fallback=5))
    retry = int(conf.getfloat(x, "retry", fallback=3))
    enabled = conf.getint(x, "enabled", fallback=1)

    if enabled <= 0:
        _log(f"{x} disabled, skip.")
        return

    name = x.replace('docker:', '')
    retries = 0
    while True:
        r = None
        try:
            r = requests.get(health, timeout=5)
            if r.status_code < 400:
                retries = 0
            else:
                retries += 1
            _log(f'[{name}] {retries}/{retry}, status={r.status_code}')
        except Exception as e:
            retries += 1
            _log(f'[{name}] {retries}/{retry}, error={str(e)}')
        finally:
            if r:
                r.close()

        if retries > retry:
            try:
                _log(f'restarting docker {name}')
                _safe_popen(f'docker stop {name}')
                s = _safe_popen(f'docker inspect --format="{{.Id}}" {name}')
                if s:
                    container_id = s[0].strip()
                    pid, _ = _pidx(container_id)
                    if pid > 0:
                        _safe_popen(f"kill {pid}")
                        time.sleep(2)
                        _safe_popen(f"kill -9 {pid}")
                _safe_popen(f'rm -rf /run/docker/runtime-runc/moby/{container_id}')
                _safe_popen(f'docker start {name}')
                retries = -20
                _log(f'restarted docker {name}')
            except Exception as e:
                _log(f'[{name}] restart error: {e}')

        gc.collect()
        time.sleep(check)

def disk_info(path):
    try:
        disk = psutil.disk_usage(path)
        total = disk.total / 1024 / 1024 / 1024    # GB
        if disk.percent > 90:
            return "<i style='color:red'>" + path + ':' + str(round(total, 1)) + 'G - ' + str(round(disk.percent)) + '%</i>'
        else:
            return path + ':' + str(round(total, 1)) + 'G - ' + str(round(disk.percent)) + '%'
    except Exception as e:
        _log(f'error={str(e)}')
        return ''
        
def _node_main(x):
    global conf

    hello = conf.get(x, "hello", fallback="")
    token = conf.get(x, "token", fallback="")
    modules = conf.get(x, "modules", fallback="")
    check = int(conf.getfloat(x, "check", fallback=5))
    enabled = conf.getint(x, "enabled", fallback=1)

    if enabled <= 0:
        _log(f"{x} disabled, skip.")
        return

    name = x.replace('node:', '')
    while True:
        r = None
        try:
            #获取cpu, mem, disk, netstat
            
            j1 = {'name':name,
                'modules': modules,
                'token': token}
            j1['cores'] = psutil.cpu_count(logical=True)
            j1['cpu_usage'] = psutil.cpu_percent(interval=1)
            mem = psutil.virtual_memory()
            j1['mem_total'] = mem.total
            j1['mem_usage'] = round(mem.percent)
            j1['uptime'] = psutil.boot_time() * 1000
            j1['os'] = platform.system()
            j1['time'] = datetime.now(ZoneInfo("Asia/Shanghai")).strftime("%H:%M:%S<br>%Y-%m-%d")
            j1['disk'] = disk_info('/') + '<br>' + disk_info('/data')
            freq = psutil.cpu_freq()
            if freq:
                j1['ghz'] = round(freq.current / 1000, 1)
            
            r = requests.post(hello, json=j1, timeout=5, verify=False)
            res = r.json()
            if res.get('state') != 200:
                _log(f'error={str(res)}')
            r.close()
            
        except Exception as e:
            _log(f'[{name}], error={str(e)}')
        finally:
            if r:
                r.close()
        gc.collect()
        time.sleep(check)

def _ha_main(x):
    global conf
    enabled = conf.getint(x, "enabled", fallback=1)
    if enabled != 1:
        _log(f"{x} disabled, skip.")
        return

    ip = conf.get(x, "ip")
    iface = conf.get(x, "iface")
    standby = conf.get(x, "standby")
    check = conf.getfloat(x, "check", fallback=3.0)

    while True:
        try:
            resp = os.system(f"ping -c 1 -W 1 {standby}")
            if resp == 0:
                resp = os.system(f"ping -c 1 -W 1 {ip}")
                if resp != 0:
                    _safe_popen(f"ip address add {ip} dev {iface}")
            else:
                _safe_popen(f"ip address add {ip} dev {iface}")
        except Exception as e:
            _log(f"_ha_main error: {str(e)}")

        gc.collect()
        time.sleep(check)

def _ha_start(x):
    try:
        t = threading.Thread(target=_ha_main, args=(x,))
        t.start()
    except Exception as e:
        _log(f"_ha_start error: {e}")

